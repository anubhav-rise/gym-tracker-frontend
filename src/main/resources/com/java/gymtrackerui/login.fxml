<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.java.gymtrackerui.LoginController">

    <VBox styleClass="hero-panel" prefWidth="360" spacing="30" HBox.hgrow="NEVER">

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="GT" styleClass="logo-badge"/>
            <Label text="Gym Progress Tracker" styleClass="logo-text"/>
        </HBox>

        <Label text="●  Welcome back" styleClass="badge-pill" maxWidth="Infinity"/>

        <VBox spacing="0">
            <Label text="Stay consistent" styleClass="hero-headline" wrapText="true"/>
            <Label text="with your training." styleClass="hero-headline-accent" wrapText="true"/>
        </VBox>

        <Label text="Log every workout, track every goal, and see your progress clearly over time."
               styleClass="hero-subtitle" wrapText="true"/>

        <VBox spacing="14">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="✓" styleClass="check-icon"/>
                <Label text="Log workouts and track sets" styleClass="check-item-text"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="✓" styleClass="check-icon"/>
                <Label text="Set goals and monitor progress" styleClass="check-item-text"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="✓" styleClass="check-icon"/>
                <Label text="See it all on one calendar" styleClass="check-item-text"/>
            </HBox>

        </VBox>

    </VBox>

    <StackPane styleClass="form-panel" HBox.hgrow="ALWAYS">

        <VBox styleClass="auth-card" spacing="16" maxWidth="340" maxHeight="Infinity" alignment="CENTER">

            <Label text="Sign in" styleClass="form-title"/>
            <Label text="Welcome back, please enter your details" styleClass="form-subtitle" wrapText="true"/>

            <HBox styleClass="tab-bar" spacing="4">
                <Label text="Sign in" styleClass="tab-button-active" HBox.hgrow="ALWAYS" maxWidth="Infinity" alignment="CENTER"/>
                <Button text="Create account" onAction="#goToRegister" styleClass="tab-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

            <VBox spacing="6">
                <Label text="Email" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                <HBox styleClass="input-wrapper">
                    <Label text="✉" styleClass="input-icon"/>
                    <TextField fx:id="emailField" promptText="you@example.com" styleClass="input-inner" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                <HBox styleClass="input-wrapper">
                    <Label text="●" styleClass="input-icon"/>
                    <PasswordField fx:id="passwordField" promptText="Your password" styleClass="input-inner" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <Button text="Sign in  →" onAction="#handleLogin" maxWidth="Infinity"/>

            <Hyperlink text="Forgot password?" onAction="#goToForgotPassword"/>

            <Label fx:id="statusLabel" wrapText="true"/>

        </VBox>

    </StackPane>

</HBox>