<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.java.gymtrackerui.CalendarController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER">
        <Button text="◀ Prev" onAction="#handlePrevMonth"/>
        <Label fx:id="monthLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Button text="Next ▶" onAction="#handleNextMonth"/>
    </HBox>

    <GridPane fx:id="calendarGrid" hgap="5" vgap="5" alignment="CENTER"/>

    <Label text="Highlighted dates = workout logged" style="-fx-font-style: italic;"/>

    <Button text="Back to Dashboard" onAction="#goBack"/>

</VBox>