<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.java.gymtrackerui.WorkoutsController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="My Workouts" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <ListView fx:id="workoutListView" prefHeight="200"/>

    <Label text="Add New Workout:" style="-fx-font-weight: bold;"/>

    <TextField fx:id="titleField" promptText="Title (e.g. Leg Day)"/>

    <TextField fx:id="dateField" promptText="Date (YYYY-MM-DD)"/>

    <TextField fx:id="durationField" promptText="Duration (minutes)"/>

    <HBox spacing="10">
        <Button text="Add Workout" onAction="#handleAddWorkout"/>
        <Button text="Delete Selected" onAction="#handleDeleteWorkout"/>
        <Button text="Back to Dashboard" onAction="#goBack"/>
    </HBox>

    <Label fx:id="statusLabel"/>

</VBox>