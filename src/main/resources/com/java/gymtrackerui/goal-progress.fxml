<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.java.gymtrackerui.GoalProgressController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="titleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <ListView fx:id="progressListView" prefHeight="180"/>

    <Label text="Log New Progress:" style="-fx-font-weight: bold;"/>

    <TextField fx:id="dateField" promptText="Date (YYYY-MM-DD)"/>

    <TextField fx:id="valueField" promptText="Current value"/>

    <HBox spacing="10">
        <Button text="Add Progress" onAction="#handleAddProgress"/>
        <Button text="Delete Selected" onAction="#handleDeleteProgress"/>
        <Button text="Back to Goals" onAction="#goBack"/>
    </HBox>

    <Label fx:id="statusLabel"/>

</VBox>